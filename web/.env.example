# Supabase — احتفظ بالـ service role key على السيرفر فقط، Never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# بيانات الأدمن (غيّرها قبل النشر)
# ADMIN_PASSWORD هو الافتراضي فقط؛ بمجرد تغيير كلمة المرور من /admin/password
# تُحفظ نسخة مشفّرة في Supabase وتُستخدم بدل المتغير أدناه.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret
